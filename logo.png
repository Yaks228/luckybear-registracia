<!-- PNG version of Lucky Bear Casino Logo -->
<svg width="256" height="256" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Gradient for the bear -->
    <linearGradient id="bearGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#3b82f6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#60a5fa;stop-opacity:1" />
    </linearGradient>
    
    <!-- Gradient for the coin -->
    <linearGradient id="coinGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fbbf24;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f59e0b;stop-opacity:1" />
    </linearGradient>
    
    <!-- Drop shadow filter -->
    <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="4" dy="4" stdDeviation="4" flood-color="#000000" flood-opacity="0.4"/>
    </filter>
  </defs>
  
  <!-- Background circle -->
  <circle cx="128" cy="128" r="120" fill="#0f172a" stroke="#1e40af" stroke-width="6"/>
  
  <!-- Bear head -->
  <ellipse cx="128" cy="128" rx="60" ry="52" fill="url(#bearGradient)" filter="url(#dropShadow)"/>
  
  <!-- Bear ears -->
  <ellipse cx="90" cy="90" rx="20" ry="25" fill="url(#bearGradient)" transform="rotate(-30 90 90)"/>
  <ellipse cx="166" cy="90" rx="20" ry="25" fill="url(#bearGradient)" transform="rotate(30 166 90)"/>
  
  <!-- Inner ears -->
  <ellipse cx="92" cy="92" rx="10" ry="15" fill="#1e40af" transform="rotate(-30 92 92)"/>
  <ellipse cx="164" cy="92" rx="10" ry="15" fill="#1e40af" transform="rotate(30 164 92)"/>
  
  <!-- Eyes -->
  <ellipse cx="108" cy="115" rx="8" ry="10" fill="#ffffff"/>
  <ellipse cx="148" cy="115" rx="8" ry="10" fill="#ffffff"/>
  <ellipse cx="108" cy="115" rx="4" ry="5" fill="#0f172a"/>
  <ellipse cx="148" cy="115" rx="4" ry="5" fill="#0f172a"/>
  
  <!-- Nose -->
  <ellipse cx="128" cy="135" rx="5" ry="4" fill="#0f172a"/>
  
  <!-- Mouth -->
  <path d="M 128 135 Q 122 142 116 135" stroke="#0f172a" stroke-width="3" fill="none"/>
  <path d="M 128 135 Q 134 142 140 135" stroke="#0f172a" stroke-width="3" fill="none"/>
  
  <!-- Lucky coin -->
  <circle cx="180" cy="180" r="24" fill="url(#coinGradient)" filter="url(#dropShadow)"/>
  <text x="180" y="188" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#ffffff">₽</text>
  
  <!-- Casino chips -->
  <circle cx="76" cy="180" r="16" fill="#dc2626" stroke="#ffffff" stroke-width="3"/>
  <circle cx="76" cy="180" r="8" fill="none" stroke="#ffffff" stroke-width="2"/>
  
  <!-- Sparkles -->
  <g fill="#fbbf24" opacity="0.9">
    <circle cx="50" cy="50" r="3"/>
    <circle cx="206" cy="64" r="2"/>
    <circle cx="218" cy="154" r="1.5"/>
    <circle cx="38" cy="166" r="2"/>
    <circle cx="206" cy="206" r="1.5"/>
  </g>
  
  <!-- Text -->
  <text x="128" y="235" text-anchor="middle" font-family="Montserrat, Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">LUCKY BEAR</text>
  
  <!-- Crown (optional luxury element) -->
  <path d="M 128 60 L 118 50 L 128 40 L 138 50 Z" fill="#fbbf24" stroke="#f59e0b" stroke-width="2"/>
  <rect x="126" y="40" width="4" height="15" fill="#f59e0b"/>
</svg>